{
  "name": "undangan-digital",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "app:up": "docker compose up -d --build --wait app",
    "app:logs": "docker compose logs -f app",
    "db:reset": "docker compose down -v && docker compose up -d --wait db && drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:templates": "tsx src/db/sync-templates.ts",
    "admin:buat": "tsx src/db/create-admin.ts"
  },
  "dependencies": {
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/italianno": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/marcellus": "^5.3.0",
    "@fontsource/mulish": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "baileys": "7.0.0-rc14",
